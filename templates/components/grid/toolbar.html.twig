<div class="d-flex gap-2 mb-3"><input class="form-control" type="search" placeholder="Recherche globale" data-{{ controller }}-target="globalSearch" data-action="input->{{ controller }}#onGlobalSearch"><button class="btn btn-outline-secondary" data-action="click->{{ controller }}#resetFilters">Réinitialiser</button><button class="btn btn-outline-primary" data-action="click->{{ controller }}#exportCsv">Exporter CSV</button><button class="btn btn-outline-success" data-{{ controller }}-target="bulkButton" disabled data-action="click->{{ controller }}#bulkActivate">Activer</button><button class="btn btn-outline-danger" data-action="click->{{ controller }}#bulkDeactivate">Désactiver</button><span data-{{ controller }}-target="selectionCount">0 sélection</span></div>
