{% set c=engine=='datatables'?'datatables-grid':(engine=='tabulator'?'tabulator-grid':'native-grid') %}<section class="data-grid" data-controller="{{ c }}" data-{{ c }}-endpoint-value="{{ endpoints[engine] }}" data-{{ c }}-export-url-value="{{ endpoints.export }}" data-{{ c }}-bulk-activate-url-value="{{ endpoints.bulkActivate }}" data-{{ c }}-bulk-deactivate-url-value="{{ endpoints.bulkDeactivate }}" data-{{ c }}-csrf-token-value="{{ csrf }}" data-{{ c }}-grid-id-value="{{ grid.id }}" data-{{ c }}-page-size-value="{{ grid.defaultPageSize }}" data-{{ c }}-max-page-size-value="{{ grid.maxPageSize }}" data-{{ c }}-columns-value="{{ grid.columns|json_encode|e('html_attr') }}">{% include 'components/grid/toolbar.html.twig' with {controller:c} only %}{% include 'components/grid/filters.html.twig' with {grid:grid,controller:c} only %}<p class="alert alert-danger d-none" data-{{ c }}-target="error"></p><div class="d-none" data-{{ c }}-target="loading">Chargement…</div>{% if engine=='tabulator' %}<div data-{{ c }}-target="tabulator"></div>{% else %}<table class="table" data-{{ c }}-target="table"><thead><tr><th><input type="checkbox" data-{{ c }}-target="selectPage" data-action="change->{{ c }}#togglePageSelection"></th>{% for col in grid.columns %}<th data-grid-column-id="{{ col.id }}">{% if col.sortable %}<button type="button" data-column-id="{{ col.id }}" data-action="click->{{ c }}#toggleSort">{{ col.label }}</button>{% else %}{{ col.label }}{% endif %}</th>{% endfor %}</tr></thead><tbody data-{{ c }}-target="body"></tbody></table>{% endif %}<p class="d-none" data-{{ c }}-target="empty">Aucun résultat.</p>{% if engine=='native' %}{% include 'components/grid/native_pagination.html.twig' with {controller:c} only %}{% endif %}</section>
