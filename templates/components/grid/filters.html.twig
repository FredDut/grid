<div class="row g-2 mb-3">{% for col in grid.columns if col.filterable %}<div class="col-md-3"><label>{{ col.label }}</label><div class="input-group"><input class="form-control" data-grid-filter-value="{{ col.id }}" data-grid-filter-type="{{ col.filterType.value }}" data-action="input->{{ controller }}#onFilterChange"><select class="form-select" data-grid-filter-operator="{{ col.id }}" data-action="change->{{ controller }}#onOperatorChange">{% for op in col.operators %}<option value="{{ op.value }}">{{ op.symbol }}</option>{% endfor %}</select></div><input class="form-control mt-1 d-none" data-grid-second-filter-value="{{ col.id }}" data-grid-second-filter-container="{{ col.id }}"></div>{% endfor %}</div>
